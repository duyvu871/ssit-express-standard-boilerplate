<div class="min-h-screen" x-data="{
    files: [],
    currentPage: 1,
    totalPages: 1,
    itemsPerPage: 10,
    loading: false,
    error: '',
    dragOver: false,
    uploadFiles: [],
    uploading: false,
    uploadProgress: {},
    previewUrls: {},
    maxFileSize: 5 * 1024 * 1024,
    allowedTypes: ['image/jpeg', 'image/png', 'image/gif', 'application/pdf'],

    async fetchFiles() {
        this.loading = true;
        this.error = '';
        try {
            const accessToken = localStorage.getItem('accessToken');
            if (!accessToken) {
                window.location.href = '/';
                return;
            }
            
            const response = await fetch(`/api/v1/asset/list?page=${this.currentPage}&limit=${this.itemsPerPage}`, {
                method: 'GET',
                headers: {
                    'Authorization': `Bearer ${accessToken}`,
                    'Content-Type': 'application/json'
                }
            });
            
            if (!response.ok) {
                throw new Error('Failed to fetch files');
            }
            
            const data = await response.json();
            this.files = data.data.files;
            this.totalPages = Math.ceil(data.data.total / this.itemsPerPage);
        } catch (err) {
            this.error = err.message;
        } finally {
            this.loading = false;
        }
    },

    handleDrop(e) {
        e.preventDefault();
        this.dragOver = false;
        const droppedFiles = [...e.dataTransfer.files];
        this.validateAndAddFiles(droppedFiles);
    },

    validateAndAddFiles(newFiles) {
        Array.from(newFiles).forEach(file => {
            if (!this.allowedTypes.includes(file.type)) {
                this.error = `File type ${file.type} is not supported`;
                return;
            }
            if (file.size > this.maxFileSize) {
                this.error = `File ${file.name} is too large (max 5MB)`;
                return;
            }
            this.uploadFiles.push(file);
            if (file.type.startsWith('image/')) {
                this.createPreview(file);
            }
        });
    },

    createPreview(file) {
        const reader = new FileReader();
        reader.onload = (e) => {
            this.previewUrls[file.name] = e.target.result;
        };
        reader.readAsDataURL(file);
    },

    async uploadSelectedFiles() {
        this.uploading = true;
        this.error = '';
        const accessToken = localStorage.getItem('accessToken');

        for (const file of this.uploadFiles) {
            this.uploadProgress[file.name] = 0;
            const formData = new FormData();
            formData.append('file', file);

            try {
                const response = await fetch('/api/v1/asset/upload', {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${accessToken}`
                    },
                    body: formData
                });

                if (!response.ok) {
                    throw new Error(`Upload failed for ${file.name}`);
                }

                this.uploadProgress[file.name] = 100;
            } catch (err) {
                this.error = err.message;
                this.uploadProgress[file.name] = 0;
            }
        }

        this.uploading = false;
        if (!this.error) {
            this.uploadFiles = [];
            this.previewUrls = {};
            this.uploadProgress = {};
            await this.fetchFiles();
        }
    },

    removeFile(fileName) {
        this.uploadFiles = this.uploadFiles.filter(f => f.name !== fileName);
        delete this.previewUrls[fileName];
        delete this.uploadProgress[fileName];
    },

    async deleteFile(fileId) {
        if (!confirm('Are you sure you want to delete this file?')) {
            return;
        }

        try {
            const accessToken = localStorage.getItem('accessToken');
            const response = await fetch(`/api/v1/asset/delete/${fileId}`, {
                method: 'DELETE',
                headers: {
                    'Authorization': `Bearer ${accessToken}`,
                    'Content-Type': 'application/json'
                }
            });

            if (!response.ok) {
                throw new Error('Failed to delete file');
            }

            await this.fetchFiles();
        } catch (err) {
            this.error = err.message;
        }
    },

    formatFileSize(bytes) {
        if (bytes === 0) return '0 Bytes';
        const k = 1024;
        const sizes = ['Bytes', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    },

    getFileIcon(mimeType) {
        if (mimeType.startsWith('image/')) {
            return 'M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z';
        }
        return 'M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z';
    }
}" x-init="fetchFiles()">
    <div class="bg-white shadow-md rounded-lg p-6 max-w-6xl mx-auto">
        <div class="flex justify-between items-center mb-6 pb-4 border-b border-gray-200">
            <h1 class="text-2xl font-bold text-gray-800">File Manager</h1>
        </div>

        <!-- Error Display -->
        <div x-show="error" x-cloak class="mb-4">
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative">
                <span x-text="error"></span>
            </div>
        </div>

        <!-- Upload Section -->
        <div class="mb-8">
            <div class="border-2 border-dashed rounded-lg p-6 text-center"
                :class="{ 'border-blue-500 bg-blue-50': dragOver, 'border-gray-300': !dragOver }"
                @dragover.prevent="dragOver = true"
                @dragleave.prevent="dragOver = false"
                @drop.prevent="handleDrop($event)">
                <div class="space-y-2">
                    <svg class="mx-auto h-12 w-12 text-gray-400" stroke="currentColor" fill="none" viewBox="0 0 48 48">
                        <path d="M24 8l-8 8h6v16h4V16h6l-8-8z" fill="currentColor" />
                        <path d="M4 28v12a4 4 0 004 4h32a4 4 0 004-4V28" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    <div class="text-sm text-gray-600">
                        <label for="file-upload" class="relative cursor-pointer bg-white rounded-md font-medium text-blue-600 hover:text-blue-500 focus-within:outline-none focus-within:ring-2 focus-within:ring-offset-2 focus-within:ring-blue-500">
                            <span>Upload files</span>
                            <input id="file-upload" type="file" class="sr-only" multiple @change="validateAndAddFiles($event.target.files)">
                        </label>
                        <p class="pl-1">or drag and drop</p>
                    </div>
                    <p class="text-xs text-gray-500">PNG, JPG, GIF, PDF up to 5MB</p>
                </div>
            </div>

            <!-- Upload Preview -->
            <div x-show="uploadFiles.length > 0" class="mt-4 space-y-4">
                <template x-for="file in uploadFiles" :key="file.name">
                    <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
                        <div class="flex items-center space-x-4">
                            <template x-if="previewUrls[file.name]">
                                <img :src="previewUrls[file.name]" class="h-12 w-12 object-cover rounded">
                            </template>
                            <template x-if="!previewUrls[file.name]">
                                <svg class="h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                                </svg>
                            </template>
                            <div>
                                <p class="text-sm font-medium text-gray-900" x-text="file.name"></p>
                                <p class="text-sm text-gray-500" x-text="formatFileSize(file.size)"></p>
                            </div>
                        </div>
                        <button @click="removeFile(file.name)" class="text-red-600 hover:text-red-800">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>
                </template>
                <div class="flex justify-end">
                    <button @click="uploadSelectedFiles()" :disabled="uploading" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 disabled:opacity-50">
                        <span x-text="uploading ? 'Uploading...' : 'Upload Files'"></span>
                    </button>
                </div>
            </div>
        </div>

        <!-- File List -->
        <div x-show="loading" class="text-center py-8">
            <div class="inline-block animate-spin rounded-full h-8 w-8 border-b-2 border-gray-800"></div>
            <p class="mt-2 text-gray-600">Loading files...</p>
        </div>

        <div x-show="!loading && files.length === 0" class="text-center py-8">
            <p class="text-gray-600">No files uploaded yet</p>
        </div>

        <div x-show="!loading && files.length > 0" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <template x-for="file in files" :key="file.fileId">
                <div class="bg-white rounded-lg border p-4 hover:shadow-md transition-shadow duration-200">
                    <div class="flex items-center space-x-4">
                        <svg class="h-10 w-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" :d="getFileIcon(file.mimetype)" />
                        </svg>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-gray-900 truncate" x-text="file.fileName"></p>
                            <p class="text-sm text-gray-500" x-text="formatFileSize(file.fileSize)"></p>
                            <p class="text-xs text-gray-400" x-text="new Date(file.uploadedAt).toLocaleDateString()"></p>
                        </div>
                        <div class="flex space-x-2">
                            <a :href="file.url" target="_blank" class="text-blue-600 hover:text-blue-800">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                                </svg>
                            </a>
                            <button @click="deleteFile(file.fileId)" class="text-red-600 hover:text-red-800">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            </template>
        </div>

        <!-- Pagination -->
        <div x-show="totalPages > 1" class="mt-6 flex justify-center space-x-2">
            <button @click="currentPage > 1 && (currentPage--, fetchFiles())" :disabled="currentPage === 1"
                class="px-3 py-1 rounded-md bg-gray-100 text-gray-700 hover:bg-gray-200 disabled:opacity-50">
                Previous
            </button>
            <template x-for="page in totalPages" :key="page">
                <button @click="currentPage = page; fetchFiles()"
                    :class="{
                        'bg-blue-600 text-white': currentPage === page,
                        'bg-gray-100 text-gray-700 hover:bg-gray-200': currentPage !== page
                    }"
                    class="px-3 py-1 rounded-md">
                    <span x-text="page"></span>
                </button>
            </template>
            <button @click="currentPage < totalPages && (currentPage++, fetchFiles())" :disabled="currentPage === totalPages"
                class="px-3 py-1 rounded-md bg-gray-100 text-gray-700 hover:bg-gray-200 disabled:opacity-50">
                Next
            </button>
        </div>
    </div>
</div>